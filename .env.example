# ---- Copy to .env and fill in. `.env` is gitignored. ----

# Postgres
POSTGRES_USER=pulsevault
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=pulsevault
# Used by the backend to reach the db service inside the compose network.
DATABASE_URL=postgresql+psycopg://pulsevault:change-me-please@db:5432/pulsevault

# App auth (single-user). Login to the web UI uses these.
APP_USERNAME=admin
APP_PASSWORD=change-me-too
# Random string used to sign session tokens. Generate: openssl rand -hex 32
APP_SECRET_KEY=replace-with-openssl-rand-hex-32

# Desktop companion agent auth. Static bearer token the agent sends when
# uploading FIT files. Leave blank to have the server generate one (view it in
# Settings → Device Sync). Set it explicitly to pin a known value.
INGEST_TOKEN=

# Garmin Connect. The password is only used for the one-time interactive login
# (to seed the auto-refreshing token cache) and is NOT persisted by the app.
# You can leave these blank and log in from the Settings page instead.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# How often (minutes) the scheduler pulls fresh data from Garmin Connect.
SYNC_INTERVAL_MINUTES=180
# How many days back to backfill on the very first sync.
INITIAL_BACKFILL_DAYS=30

# Timezone used when bucketing daily summaries (IANA name).
TZ=America/New_York

# Host port the web UI is published on (http://localhost:<PROXY_PORT>).
PROXY_PORT=8080
